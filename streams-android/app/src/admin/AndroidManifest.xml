<?xml version="1.0" encoding="utf-8"?>
<!-- "Streams Admin" only (owner's phone): Auto-verify payments reads the bank's "credited"
     SMS and UPI app notifications. Kept out of the customer app so Play Protect allows it. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECEIVE_SMS" />

    <application>
        <receiver
            android:name="com.streams.app.payments.PaymentSmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>
        <service
            android:name="com.streams.app.payments.PaymentNotificationListener"
            android:exported="true"
            android:label="Streams payment auto-verify"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
